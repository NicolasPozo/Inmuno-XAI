# --- Modelos entrenados -------------------------------------------------------
# TabPFN guarda dentro del archivo a los pacientes de entrenamiento (datos de
# ImmPort), así que ningún .joblib del modelo inmunológico se publica.
# Solo se suben los ElasticNet epigenéticos (coeficientes, datos públicos de GEO).
*.joblib
!Modelo 1/modelos/elasticnet_reloj_epigenetico.joblib
!XAI/modelos/epigenetico_elasticnet/modelo_elasticnet.joblib

# --- Datos por paciente de ImmPort (Stanford 10K) ------------------------------
# Archivos con IDs de sujetos (SUB...), sus edades o sus biomarcadores.
*.npz
